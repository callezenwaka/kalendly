{
  "name": "kalendly",
  "version": "0.3.4",
  "description": "A universal calendar web component — works in React, Vue, Angular, Svelte, Solid.js, and plain HTML with no framework dependency",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup && npm run copy:styles && npm run copy:dist",
    "copy:styles": "mkdir -p dist/styles && cp src/styles/calendar.css dist/styles/",
    "copy:dist": "rm -rf docs/dist && cp -r dist docs/dist",
    "dev": "tsup --watch",
    "dev:examples": "npm run build && serve docs -p 5173",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node tests/integration/package-validation.test.mjs",
    "test:manual": "echo 'Open tests/manual/*.html in browser' && serve . -p 8080",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run test:run && npm run build",
    "prepack": "npm run test:package",
    "test:browser": "npm run build && playwright test",
    "test:browser:ui": "npm run build && playwright test --ui",
    "test:browser:headed": "npm run build && playwright test --headed",
    "test:browser:install": "playwright install chromium webkit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/styles/calendar.css"
    }
  },
  "files": [
    "dist",
    "styles.d.ts",
    "README.md",
    "LICENSE"
  ],
  "lint-staged": {
    "*.{ts,js,json,css,md}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix",
      "vitest related --run",
      "bash -c 'tsc --noEmit'"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "serve": "^14.2.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "calendar",
    "scheduler",
    "web-components",
    "custom-elements",
    "typescript",
    "react",
    "vue",
    "angular",
    "events",
    "datepicker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callezenwaka/kalendly.git"
  },
  "bugs": {
    "url": "https://github.com/callezenwaka/kalendly/issues"
  },
  "homepage": "https://github.com/callezenwaka/kalendly#readme",
  "author": "Callis Ezenwaka <callisezenwaka@outlook.com>",
  "license": "MIT"
}
